<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<style type="text/css">
.salaryred {
	color:red;
}
.salarybold{
	font-weight:bold;
}
</style>
<title>Insert title here</title>
</head>
<body>
<h1>employee - list</h1>
<h2>[[${#{list.size(empList)}}]]</h2>
<table>
 <tr>
 <th>employee_id</th>
 <th>first_name</th>
 <th>last_name</th>
 <th>hire_date</th>
 </tr>
<tr th:each="emp : ${empList}">
<!-- <tr th:each="emp, status : ${empList}"> -->
<!-- <td th:text="${status.index}"></td>  -->
 <td th:text="${empStat.index}"></td>
 <td th:text="${emp.employeeId}"></td>
 <td th:text="${emp.firstName}"></td>
 <td th:text="${emp.lastName}"></td>
 <td class="salarybold" th:text="${#numbers.formatDecimal(emp.salary, 0, 'COMMA', 0, 'POINT')}" th:classappend="${emp.salary > 10000 ? 'salaryred' : '' }"></td>
 <td th:text="${    #dates.format(emp.hireDate,'yyyy-MM')    }"></td>
 </tr>
</table>
</body>
</html>