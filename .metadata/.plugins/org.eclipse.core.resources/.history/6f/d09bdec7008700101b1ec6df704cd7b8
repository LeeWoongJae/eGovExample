<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
<table>
<tr th:each="emp : ${emp}">
<td>사번</td><td th:text="${emp.employeeId}"></td>
<td>이름</td><td th:text="${emp.lastName}"></td>
<td>급여</td><td th:text="${emp.salary}"></td>
<td>입사날짜</td><td th:text="${emp.hireDate}"></td>
</tr>
</table>
</body>
</html>