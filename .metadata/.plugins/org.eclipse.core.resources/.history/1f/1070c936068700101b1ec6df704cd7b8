<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
<h1>사원정보</h1>
<table>
<tr>
<td>사원번호 : </td>
<td th:text="${emp.employeeId}"></td>
</tr>
<tr>
<td>사원명 : </td>
<td>[[${emp.firstName}]] [[${emp.lastName}]]</td>
</tr>
<tr>
<td>부서명 : </td>
<td th:text="${emp.employeeId}"></td>
</tr>
<tr>
<td>급여 : </td>
<td th:text="${ #numbers.formatDecimal(emp.salary,0,'COMMA',0,'COMMA')}"></td>
</tr>
<tr>
<td>입사날짜 : </td>
<td th:text="${ #dates.format(emp.hireDate, 'yyyy-MM-dd') }"></td>
</tr>
</table>
<table>
<tr>
 <th>사번</th>
 <th>이름</th>
 <th>부서명</th>
 <th>급여</th>
 <th>입사날짜</th>
 </tr>
