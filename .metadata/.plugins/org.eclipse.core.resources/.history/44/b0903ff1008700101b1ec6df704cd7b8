<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
<table>
<tr th:each="emp : ${emp}">
<td>사번</td><td th:text="${emp.employeeId}"></td>
<td>이름</td><td th:text="${emp.lastName}"></td>
<td>부서명</td><td th:text="${emp.departmentName}"></td>
<td>급여</td><td th:text="${ #numbers.formatDecimal(emp.salary,0,'COMMA',0,'COMMA')}"></td>
<td>입사날짜</td><td th:text="${ #dates.format(emp.hireDate, 'yyyy-MM') }"></td>
</tr>
</table>
</body>
</html>