package com.example.demo;

import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import com.example.demo.emp.mapper.EmpMapper;
import com.example.demo.emp.mapper.EmpVO;

@SpringBootTest
public class EmpMapperTest {
	@Autowired
	EmpMapper empMapper;
	
	@DisplayName("전체조회")
	@Test
	public void selectEmp() {
		empMapper.selectEmp().forEach(emp -> System.out.println(emp.getLastName()));
	}
	
	@DisplayName("단건조회")
	@Test
	public void selectEmpById() {
		EmpVO empVo = empMapper.selectEmpById(100L);
		System.out.println("employeeId:"+empVo.getFirstName());
	}
}